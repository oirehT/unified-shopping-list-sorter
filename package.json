{
	"name": "unified-shopping-list-sorter",
	"version": "1.0.3",
	"description": "Auto-sort managed shopping lists in Obsidian.",
	"main": "main.js",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"shopping-list"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"obsidian": "1.14.4",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	}
}
